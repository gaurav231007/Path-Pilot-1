# Local-only Gemini configuration template.
# IMPORTANT: Put your real key in .env on your own machine. NEVER commit .env to GitHub.
# .env is already listed in .gitignore.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Local-only Supabase configuration template.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Example local .env:
# GEMINI_API_KEY=AIza...
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-key
